# --- Aplicação ---
PORT=3000
NODE_ENV=development

# --- Banco de dados ---
# Provedores gerenciados (Render, Neon, Railway...) entregam uma connection
# string única. Se DATABASE_URL estiver definida, ela tem prioridade sobre as
# variáveis avulsas abaixo.
# DATABASE_URL=postgresql://usuario:senha@host:5432/brain_agriculture

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=brain_agriculture

# true quando o Postgres exige TLS (provedores gerenciados: Neon, Render, RDS...)
DB_SSL=false
# true para logar as queries SQL executadas pelo TypeORM
DB_LOGGING=false

# --- Migrations ---
# true executa as migrations pendentes no boot da API (usado no Docker/nuvem)
MIGRATIONS_RUN_ON_START=true
